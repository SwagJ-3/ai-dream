.container {
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.dream-input {
  width: 100%;
  min-height: 200rpx;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.6;
}

.dream-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 10rpx;
}

.analyze-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(45deg, #667eea, #764ba2);
  border-radius: 50rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.4);
  margin-bottom: 30rpx;
}

.analyze-btn::after {
  border: none;
}

.analyze-btn[disabled] {
  opacity: 0.7;
}

.free-tip {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 40rpx;
}

.result-area {
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.5s ease-out;
}

.result-area.show {
  opacity: 1;
  transform: translateY(0);
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.model-badge {
  display: flex;
  gap: 12rpx;
}

.badge {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.badge-primary {
  background: linear-gradient(45deg, #667eea, #764ba2);
  color: #ffffff;
}

.badge-think {
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
}

.original-dream {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.original-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 12rpx;
}

.original-text {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.6;
}

.analysis-content {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.8;
  white-space: pre-wrap;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}

.action-btn::after {
  border: none;
}

.share-btn {
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
}

.again-btn {
  background: linear-gradient(45deg, #667eea, #764ba2);
  color: #ffffff;
}

.footer {
  margin-top: auto;
  padding-top: 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}
